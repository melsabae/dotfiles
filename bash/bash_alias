alias ls='ls --color=auto'
alias sl='ls'
alias ll='ls -l --time-style=long-iso'
alias lll='ll -A'
alias lsl='ls -1 | wc -l'
alias lst='ll -t'
alias lstl='lll -t'

# color output even through pipes
alias grep='grep --color=auto'
alias ngrep='grep -n'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
# less strips color sometimes
alias less='less -R'

alias vim.tiny='vim'
alias vi='vim'
alias vm='vim'
alias im='vim'
alias pythong='py'
alias py='python'
alias top='htop'

alias tmux='tmux -f ~/.config/tmux.conf'
alias valgrind='valgrind --leak-check=full --track-origins=yes'

alias cal="cal -3"

alias jobs='jobs -l'

if [[ $(which trizen 2>/dev/null) ]]; then
    alias trizen="CMAKE_BUILD_PARALLEL_LEVEL=8 trizen"
fi

